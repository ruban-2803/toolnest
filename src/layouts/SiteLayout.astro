---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f9f8" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "12c98cde187442e6957f023b26f22bc6"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ToolNest home">
        <span class="brand-mark" aria-hidden="true">T</span>
        <span>Tool<span>Nest</span></span>
      </a>
      <nav class="top-nav" aria-label="Main navigation">
        <a href="/#tools">Tools</a>
        <a href="/#converters">File converters</a>
        <a href="/about">About</a>
      </nav>
      <a class="header-cta" href="/#tools">Explore tools <span aria-hidden="true">↗</span></a>
    </header>

    <slot />

    <footer class="site-footer">
      <a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true">T</span><span>Tool<span>Nest</span></span></a>
      <p>Simple tools for everyday tasks.</p>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/">Home</a>
        <a href="/#tools">Tools</a>
        <a href="/#converters">File converters</a>
        <a href="/about">About</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/contact">Contact</a>
      </nav>
      <small>© {new Date().getFullYear()} ToolNest. Made to be useful.</small>
    </footer>
  </body>
</html>
