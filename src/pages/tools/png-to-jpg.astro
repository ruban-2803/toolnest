---
import FileConverter from "../../components/FileConverter.astro";
const title = "PNG to JPG Converter — Free Online Image Tool | ToolNest";
const description = "Convert PNG images to JPG online for free. Transparent areas are filled with white, and your image is processed privately in your browser.";
---
<FileConverter title={title} description={description} format="png-to-jpg" accepted="image/png,.png" fileLabel="PNG" details="Convert PNG images to compact JPG files using your browser's Canvas API. No image data is uploaded." />
