---
import FileConverter from "../../components/FileConverter.astro";
const title = "WEBP to JPG Converter — Free Online Image Tool | ToolNest";
const description = "Convert WEBP images to JPG online for free. Transparent pixels are filled with white, with no image upload required.";
---
<FileConverter title={title} description={description} format="webp-to-jpg" accepted="image/webp,.webp" fileLabel="WEBP" details="Convert WEBP pictures to widely compatible JPG images in your browser. Any transparent pixels become white in the JPG output." />
